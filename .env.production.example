APP_NAME="GCStock"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.tu-dominio.com
APP_TIMEZONE=America/Mexico_City

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Logs a stderr: Coolify/Docker los muestra en el panel. Un archivo dentro del
# contenedor se pierde en cada redeploy.
LOG_CHANNEL=stack
LOG_STACK=stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# Base de datos de producción (MySQL gestionado, NO localhost)
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# La API se autentica solo con token Bearer (Sanctum), nunca con cookies.
# NO definir SANCTUM_STATEFUL_DOMAINS: si incluye el dominio de la web, cada
# POST desde la web pasa por la validación CSRF y responde 419.
# Vida de los tokens en minutos (43200 = 30 días); la lee config/sanctum.php.
SANCTUM_TOKEN_EXPIRATION=43200

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
# Las imágenes y evidencias van al disco "public" (storage/app/public):
# monta un volumen persistente en /app/storage/app (ver DEPLOY-COOLIFY.md).
FILESYSTEM_DISK=local
# Requiere el queue worker con --queue=notifications,default (correos y push).
QUEUE_CONNECTION=database
CACHE_STORE=database

# Telescope es solo de desarrollo: fuera de local ni se registra y viene
# apagado aunque falte esta variable. Se deja explícito por si acaso.
TELESCOPE_ENABLED=false

# Super Admin que crea `php artisan db:seed --force` en la primera instalación
# (mínimo 12 caracteres; sin ella el seeder aborta). Puede borrarse después.
ADMIN_EMAIL=admin@cocos-francisco.com
ADMIN_PASSWORD=

# Mail transaccional: configura tu proveedor real
# Opciones: smtp, mailgun, ses, postmark, resend (resend usa RESEND_KEY)
# MAIL_SCHEME en Laravel 12: "smtp" (puerto 587, STARTTLS automático) o
# "smtps" (puerto 465). "tls" o "ssl" NO son válidos y rompen el envío.
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
RESEND_KEY=
MAIL_FROM_ADDRESS="no-reply@tu-dominio.com"
MAIL_FROM_NAME="${APP_NAME}"

# URL pública del frontend, exacta y sin "/" final: CORS solo permite este
# origen en producción (y se usa en links de correos).
FRONTEND_URL=https://app.tu-dominio.com

# Firebase (notificaciones push): el service-account.json NO va en el repo ni
# en una variable. Se monta como archivo en la ruta por defecto
# /app/storage/app/firebase/service-account.json (config/services.php), tanto
# en la app como en el queue worker. No definas FIREBASE_CREDENTIALS con una
# ruta relativa: PHP-FPM la resuelve desde public/.

# WhatsApp Cloud API. Envío de órdenes de compra al proveedor: TOKEN y
# PHONE_NUMBER_ID. Webhook (el proveedor contesta "ya lo envié" y la compra
# pasa a tránsito): APP_SECRET (firma de Meta) y VERIFY_TOKEN (el mismo que
# se captura en Meta). Sin esos dos el webhook rechaza todo (no hay valores
# por defecto).
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# S3/R2 (opcional, aún no se usa: el código guarda en el disco "public" y
# faltaría instalar league/flysystem-aws-s3-v3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
